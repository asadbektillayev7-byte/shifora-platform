---
import Logo from './Logo.astro'
import Arrow from './Arrow.astro'
import { dicts, locales, pathFor, type Locale, type PageKey } from '../i18n'
import { APP_URL } from '../config'
interface Props { locale: Locale; page: PageKey }
const { locale, page } = Astro.props
const t = dicts[locale]
const links: { key: PageKey; label: string }[] = [
  { key: 'platform', label: t.nav.platform },
  { key: 'safety', label: t.nav.safety },
  { key: 'pilot', label: t.nav.pilot },
]
const demoHref = `${pathFor(locale, 'home')}#demo`
---
<header class="nav" data-nav>
  <div class="container nav__row">
    <a class="nav__brand" href={pathFor(locale, 'home')} aria-label="Shifora"><Logo compact /></a>
    <nav class="nav__links" aria-label={t.footer.pages}>
      {links.map(l => <a href={pathFor(locale, l.key)} aria-current={page === l.key ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav__right">
      <div class="lang" aria-label={t.nav.language}>
        {locales.map(l => <a href={pathFor(l, page)} aria-current={l === locale ? 'true' : undefined} hreflang={l} lang={l}>{dicts[l].short}</a>)}
      </div>
      <a class="btn btn--ghost nav__try" href={APP_URL} target="_blank" rel="noopener">{t.nav.tryDemo}<Arrow dir="external" /></a>
      <a class="btn btn--primary nav__cta" href={demoHref}>{t.nav.demo}</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-nav-toggle>
        <span data-label-open>{t.nav.menu}</span><span data-label-close hidden>{t.nav.close}</span>
      </button>
    </div>
  </div>
  <div class="nav__sheet" id="mobile-menu" hidden>
    <div class="container nav__sheet-inner">
      {links.map(l => <a class="nav__sheet-link" href={pathFor(locale, l.key)}>{l.label}<Arrow /></a>)}
      <div class="nav__sheet-actions">
        <a class="btn btn--primary btn--lg" href={demoHref}>{t.nav.demo}</a>
        <a class="btn btn--ghost btn--lg" href={APP_URL} target="_blank" rel="noopener">{t.nav.tryDemo}<Arrow dir="external" /></a>
      </div>
      <div class="lang lang--sheet">
        {locales.map(l => <a href={pathFor(l, page)} aria-current={l === locale ? 'true' : undefined} hreflang={l} lang={l}>{dicts[l].name}</a>)}
      </div>
    </div>
  </div>
</header>
<style>
  .nav { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 82%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); border-bottom: 1px solid transparent; transition: border-color .3s var(--ease); }
  .nav.is-scrolled { border-bottom-color: var(--line); }
  .nav__row { display: flex; align-items: center; gap: 28px; min-height: 72px; }
  .nav__brand { display: inline-flex; }
  .nav__links { display: flex; gap: 26px; margin-left: 12px; }
  .nav__links a { font-size: 15.5px; font-weight: 520; color: var(--ink-2); padding: 6px 0; border-bottom: 1px solid transparent; transition: color .2s var(--ease), border-color .2s var(--ease); }
  .nav__links a:hover, .nav__links a[aria-current] { color: var(--ink); border-bottom-color: var(--ink); }
  .nav__right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .lang { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; }
  .lang a { font-size: 12.5px; font-weight: 580; letter-spacing: .06em; padding: 5px 9px; border-radius: 999px; color: var(--ink-3); transition: background-color .2s var(--ease), color .2s var(--ease); }
  .lang a:hover { color: var(--ink); }
  .lang a[aria-current] { background: var(--ink); color: var(--paper); }
  .nav .btn { min-height: 42px; padding: 0 16px; font-size: 14.5px; }
  .nav__toggle { display: none; min-height: 42px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 14.5px; font-weight: 540; }
  .nav__sheet { border-top: 1px solid var(--line); background: var(--paper); }
  .nav__sheet-inner { padding: 12px 0 28px; display: grid; gap: 4px; }
  .nav__sheet-link { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); font-family: var(--font-serif); font-size: 26px; letter-spacing: -0.02em; }
  .nav__sheet-link :global(.arrow) { width: 20px; height: 20px; color: var(--teal-700); }
  .nav__sheet-actions { display: grid; gap: 10px; margin-top: 20px; }
  .lang--sheet { margin-top: 22px; justify-self: start; }
  .lang--sheet a { font-size: 14px; letter-spacing: 0; padding: 7px 12px; }
  @media (max-width: 980px) {
    .nav__links, .nav__try, .nav__right .lang { display: none; }
    .nav__cta { display: none; }
    .nav__toggle { display: inline-flex; align-items: center; }
  }
  @media (min-width: 981px) { .nav__sheet { display: none !important; } }
</style>
<script>
  const nav = document.querySelector('[data-nav]')
  const toggle = document.querySelector('[data-nav-toggle]')
  const sheet = document.getElementById('mobile-menu')
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8)
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true })
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!open))
    if (sheet) sheet.hidden = open
    toggle.querySelector('[data-label-open]')?.toggleAttribute('hidden', !open)
    toggle.querySelector('[data-label-close]')?.toggleAttribute('hidden', open)
  })
</script>
