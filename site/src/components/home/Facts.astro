---
import { rich, type Dict } from '../../i18n'
interface Props { t: Dict }
const { t } = Astro.props
---
<section class="facts" aria-labelledby="facts-title">
  <div class="container">
    <hr class="rule" />
    <p class="eyebrow facts__eyebrow" id="facts-title" data-reveal>{t.facts.eyebrow}</p>
    <ul class="facts__list">
      {t.facts.items.map((f, i) => (
        <li data-reveal style={`--i:${i + 1}`}>
          <span class="facts__value num">{f.value}</span>
          <span class="facts__label small" set:html={rich(`${f.label} [${f.fn}]`)} />
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .facts { padding: 0 0 clamp(48px, 7vw, 96px); }
  .facts__eyebrow { padding-top: 28px; }
  .facts__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .facts__list li { display: grid; gap: 10px; align-content: start; padding-left: 20px; border-left: 1px solid var(--line-strong); }
  .facts__value { font-size: clamp(38px, 4vw, 58px); line-height: 1; color: var(--teal-800); }
  .facts__label { color: var(--ink-3); max-width: 24em; }
  @media (max-width: 860px) { .facts__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; } }
</style>
