---
import { Image } from 'astro:assets'
import Arrow from '../Arrow.astro'
import { screen } from '../../lib/screens'
import { rich, type Dict } from '../../i18n'
import { APP_URL } from '../../config'
interface Props { t: Dict }
const { t } = Astro.props
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>{t.hero.eyebrow}</p>
      <h1 class="display" data-reveal style="--i:1" set:html={rich(t.hero.title)} />
      <p class="lead hero__lead" data-reveal style="--i:2">{t.hero.lead}</p>
      <div class="hero__actions" data-reveal style="--i:3">
        <a class="btn btn--primary btn--lg" href="#demo">{t.hero.primary}<Arrow /></a>
        <a class="btn btn--ghost btn--lg" href={APP_URL} target="_blank" rel="noopener">{t.hero.secondary}<Arrow dir="external" /></a>
      </div>
      <p class="hero__note small" data-reveal style="--i:4">{t.hero.note}</p>
    </div>
    <div class="hero__visual" data-reveal style="--i:2">
      <svg class="hero__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <rect x="15" y="5" width="10" height="30" rx="4" fill="var(--paper-3)" />
        <rect x="5" y="15" width="30" height="10" rx="4" fill="var(--amber-soft)" />
      </svg>
      <figure class="frame frame--bar hero__desk">
        <Image src={screen('dashboard')} alt={t.hero.captionDesk} widths={[640, 960, 1280, 1600]} sizes="(max-width: 980px) 92vw, 58vw" loading="eager" fetchpriority="high" />
      </figure>
      <figure class="phone hero__phone">
        <Image src={screen('m-patient-home')} alt={t.hero.captionPhone} widths={[240, 400, 560]} sizes="(max-width: 980px) 34vw, 220px" loading="eager" />
      </figure>
      <div class="hero__float" aria-hidden="true">
        <span class="hero__float-label">{t.hero.float.label}</span>
        <span class="hero__float-row"><strong>{t.hero.float.name}</strong><span class="hero__float-value num">{t.hero.float.value}</span></span>
        <span class="hero__float-status">{t.hero.float.status}</span>
        <span class="hero__float-time">{t.hero.float.time}</span>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { padding: clamp(40px, 6vw, 88px) 0 clamp(56px, 8vw, 120px); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero__copy .display { margin-top: 22px; }
  .hero__lead { margin-top: 26px; max-width: 34em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero__note { margin-top: 20px; color: var(--ink-3); }
  .hero__visual { position: relative; padding: 40px 0 70px 6%; }
  .hero__mark { position: absolute; z-index: 0; width: 120%; left: -4%; top: -16%; opacity: .9; pointer-events: none; }
  .hero__desk { position: relative; z-index: 1; }
  .hero__desk :global(img) { width: 100%; height: auto; }
  .hero__phone { position: absolute; z-index: 2; left: 0; bottom: 0; width: clamp(150px, 30%, 220px); }
  .hero__phone :global(img) { width: 100%; height: auto; }
  .hero__float { position: absolute; z-index: 3; right: -2%; top: 2%; display: grid; gap: 4px; padding: 14px 16px 14px 18px; min-width: 210px; background: var(--white); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 12px; box-shadow: 0 24px 48px -24px rgba(21, 48, 42, 0.35); font-size: 13.5px; animation: float 7s var(--ease) infinite; }
  .hero__float-label { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .hero__float-row { display: flex; justify-content: space-between; gap: 14px; align-items: baseline; }
  .hero__float-value { font-size: 22px; color: var(--ink); }
  .hero__float-status { color: var(--red); font-weight: 560; }
  .hero__float-time { color: var(--ink-3); font-size: 12.5px; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .hero__float { animation: none; } }
  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { margin-top: 12px; padding: 28px 0 60px 4%; }
    .hero__float { right: 0; top: 0; min-width: 180px; }
  }
  @media (max-width: 560px) {
    .hero__actions .btn { width: 100%; }
    .hero__float { font-size: 12.5px; padding: 12px 14px; min-width: 160px; }
    .hero__float-value { font-size: 18px; }
  }
</style>
